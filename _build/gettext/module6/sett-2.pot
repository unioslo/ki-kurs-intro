#: ../../source/module6/sett-2.rst:2
msgid "Sett 2"
msgstr ""

#: ../../source/module6/sett-2.rst:4
msgid "Oppgaver for å utforske muligheter i egen arbeidshverdag."
msgstr ""

#: ../../source/module6/sett-2.rst:7
msgid "Kartlegg egne arbeidsoppgaver"
msgstr ""

#: ../../source/module6/sett-2.rst:10
msgid "Steg 1"
msgstr ""

#: ../../source/module6/sett-2.rst:12
msgid "Skriv ned 5-10 arbeidsoppgaver du jobber med i løpet av en arbeidsuke. (Eks. Svare på e-poster, lage presentasjoner, skrive eller oppdatere nettsidetekst, utarbeide rapporter eller saksframlegg, planlegge undervisning, seminarer eller møter, veilede studenter, databehandling / analyse, saksbehandling)"
msgstr ""

#: ../../source/module6/sett-2.rst:14
msgid "Steg 2"
msgstr ""

#: ../../source/module6/sett-2.rst:16
msgid "Skriv noen stikkord om hva oppgaven handler om, hvor ofte du gjør den, hvor mye tid du bruker"
msgstr ""

#: ../../source/module6/sett-2.rst:18
msgid "Steg 3"
msgstr ""

#: ../../source/module6/sett-2.rst:20
msgid "Marker hvilke oppgaver som er:"
msgstr ""

#: ../../source/module6/sett-2.rst:22
msgid "rutinepreget"
msgstr ""

#: ../../source/module6/sett-2.rst:23
msgid "teksttunge"
msgstr ""

#: ../../source/module6/sett-2.rst:24
msgid "vanskelige å få oversikt over"
msgstr ""

#: ../../source/module6/sett-2.rst:25
msgid "krever mye idearbeid"
msgstr ""

#: ../../source/module6/sett-2.rst:27
msgid "Steg 4"
msgstr ""

#: ../../source/module6/sett-2.rst:29
msgid "Vurder risiko rundt bruk av KI på disse arbeidsoppgavene"
msgstr ""

#: ../../source/module6/sett-2.rst:31
msgid "Behandler du persondata?"
msgstr ""

#: ../../source/module6/sett-2.rst:32
msgid "Behandler du data som må beskyttes som for eksempel forskningshemmeligheter eller detaljer om kritisk UiO infrastruktur?"
msgstr ""

#: ../../source/module6/sett-2.rst:33
msgid "Behandler du data som er beskyttet av opphavsretten?"
msgstr ""

#: ../../source/module6/sett-2.rst:34
msgid "Hvis KI gjør feil, vil det få uheldige eller alvorlige konsekvenser?"
msgstr ""

#: ../../source/module6/sett-2.rst:37
msgid "Steg 5"
msgstr ""

#: ../../source/module6/sett-2.rst:39
msgid "Velg 2-3 oppgaver der KI kan ha potensiale for å effektivisere eller forbedre og utforsk følgende:"
msgstr ""

#: ../../source/module6/sett-2.rst:41
msgid "Hvordan kan KI brukes? Test gjerne sammen med en kollega."
msgstr ""

#: ../../source/module6/sett-2.rst:42
msgid "Hva må du gjøre selv?"
msgstr ""

#: ../../source/module6/sett-2.rst:43
msgid "Vurder hva slags risiko som kan oppstå ved å ta i bruk KI i denne oppgaven."
msgstr ""

#: ../../source/module6/sett-2.rst:44
msgid "Dersom oppgaven innebærer risiko: Tenk gjennom og skriv ned nødvendige tiltak for å redusere og kontrollere risikoen."
msgstr ""

#: ../../source/module6/sett-2.rst:47
msgid "Steg 6"
msgstr ""

#: ../../source/module6/sett-2.rst:49
msgid "Etter at du har utforsket dine arbeidsoppgaver over, oppfordrer vi deg til å teste ut å bruke KI i oppgavene der du ser størst potensiale."
msgstr ""

#: ../../source/module6/sett-2.rst:52
msgid "Steg 7"
msgstr ""

#: ../../source/module6/sett-2.rst:54
msgid "Identifiser 2-3 oppgaver der KI ikke bør brukes, og reflekter rundt hvorfor."
msgstr ""
