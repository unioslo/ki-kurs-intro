#: ../../source/module3/praktisk-ovelse-forbedre-egne-instruksjoner.rst:2
msgid "Praktisk øvelse: Forbedre egne instruksjoner"
msgstr ""

#: ../../source/module3/praktisk-ovelse-forbedre-egne-instruksjoner.rst:5
msgid "Oppgave"
msgstr ""

#: ../../source/module3/praktisk-ovelse-forbedre-egne-instruksjoner.rst:7
msgid "Tenk på en oppgave du ønsker at KI skal hjelpe deg med og som er av en litt mer kompleks art enn bare tekstforbedring. Dette kan for eksempel være planlegging av et arrangement, eller forklaring av komplekse sammenhenger eller begreper."
msgstr ""

#: ../../source/module3/praktisk-ovelse-forbedre-egne-instruksjoner.rst:10
msgid "Hvordan ville du gått løs på instruksjonen til KI-en til vanlig? -  Åpne `GPT UiO <https://www.uio.no/tjenester/it/ki/gpt-uio/index.html>`_ og skriv inn instruksjonen."
msgstr ""

#: ../../source/module3/praktisk-ovelse-forbedre-egne-instruksjoner.rst:12
msgid "Velg en av teknikkene på forrige side, og bruk prinsipper for gode instruksjoner. Forbedre instruksjonen din."
msgstr ""

#: ../../source/module3/praktisk-ovelse-forbedre-egne-instruksjoner.rst:13
msgid "Sammenligne svaret. Kan du gjøre ytterligere forbedringer ved å bruke flere teknikker?"
msgstr ""
